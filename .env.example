NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# development | staging | production  (production hides the dev-bypass login)
NEXT_PUBLIC_ENV=development
# Firebase web config (T-013). Leave empty to keep the dev-bypass login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Shared password for the seeded public demo accounts on the login screen. Inlined into the client
# bundle by Next, so it is visible to visitors: use it only for throwaway seeded demo accounts. Leave it
# empty and the demo buttons fill the address only.
NEXT_PUBLIC_DEMO_PASSWORD=
