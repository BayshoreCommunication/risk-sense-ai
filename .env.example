NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# development | staging | production  (production hides the dev-bypass login)
NEXT_PUBLIC_ENV=development
# Firebase web config (T-013). Leave empty to keep the dev-bypass login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Public all-role showcase UI gate. The backend issues a short-lived, server-scoped read-only demo
# session for one of four exact synthetic identities; no shared Firebase credential is exposed.
NEXT_PUBLIC_DEMO_ACCESS_ENABLED=false
