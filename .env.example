NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# development | staging | production  (production hides the dev-bypass login)
NEXT_PUBLIC_ENV=development
# Firebase web config (T-013). Leave empty to keep the dev-bypass login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Browser-visible password for the disposable FREE demo identity requestor@dev.local. Setting it at
# build time enables the one-click demo CTA locally and live. Never use a real account credential;
# leave it empty to keep the CTA disabled with an explicit configuration message.
NEXT_PUBLIC_DEMO_PASSWORD=
